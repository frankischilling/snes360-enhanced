				RelativePath=".\Media\Snes360.xui"
				>
				<FileConfiguration
					Name="Debug|Xbox 360"
					>
					<Tool
						Name="VCCustomBuildTool"
						CommandLine="xuipkg /nologo /d /a &quot;$(OutDir)\media\Snes360.xzp&quot; ..\Xbox\Skin\* ..\Xbox\Skin\Graphics\*&#x0D;&#x0A;"
						Outputs="$(OutDir)\media\Snes360.xzp"
					/>
				</FileConfiguration>
			</File>
			<File
				RelativePath="..\xbox\waveeffect.hlsl"
				>
				<FileConfiguration
					Name="Debug|Xbox 360"
					>
					<Tool
						Name="VCCustomBuildTool"
						Description="Compile shaders in $(InputPath)"
						CommandLine="fxc.exe &quot;$(InputPath)&quot; /nologo /Tvs_3_0 /EShadeVertex /DEntryPoint_ShadeVertex /XZi /XFd&quot;$(OutDir)\VS_$(InputName)_ShadeVertex.updb&quot; /Fo&quot;$(IntDir)\Media\Shaders\ShadeXuiEffectVertex.xvu&quot;&#x0D;&#x0A;fxc.exe &quot;$(InputPath)&quot; /nologo /Tps_3_0 /EShadePixel /DEntryPoint_ShadePixel /XZi /XFd&quot;$(OutDir)\VS_$(InputName)_ShadePixel.updb&quot; /Fo&quot;$(IntDir)\Media\Shaders\ShadeXuiEffectPixel.xpu&quot;&#x0D;&#x0A;"
						Outputs="&quot;$(IntDir)\Media\Shaders\ShadeXuiEffectVertex.xvu&quot;;&quot;$(IntDir)\Media\Shaders\ShadeXuiEffectPixel.xpu&quot;;"
					/>
				</FileConfiguration>
			</File>
			<File
				RelativePath="..\xbox\XuiEffect_Texture.png"
				>
				<FileConfiguration
					Name="Debug|Xbox 360"
					>
					<Tool
						Name="VCCustomBuildTool"
						CommandLine="copy &quot;$(InputPath)&quot; &quot;$(OutDir)\media\$(InputFileName)&quot;&#x0D;&#x0A;"
						Outputs="$(OutDir)\media\$(InputFileName)"
					/>
				</FileConfiguration>
			</File>
